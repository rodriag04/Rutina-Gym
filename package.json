{
  "name": "rutina-gym",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "iconos": "node scripts/iconos.mjs",
    "build:maricarmen": "tsc --noEmit && PERFIL=maricarmen vite build",
    "build:pages": "tsc --noEmit && BASE=/Rutina-Gym/ vite build && PERFIL=maricarmen BASE=/Rutina-Gym/maricarmen/ vite build --outDir dist/maricarmen",
    "dev:maricarmen": "PERFIL=maricarmen vite"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.6",
    "@preact/signals": "^2.3.1",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
